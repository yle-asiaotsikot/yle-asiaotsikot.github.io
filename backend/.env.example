GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Cloudflare R2
# Token needs "Workers R2 Storage: Edit" permission
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_API_TOKEN=your_cloudflare_api_token_here
R2_BUCKET_NAME=your_r2_bucket_name_here

ARTICLE_COUNT=10
RATE_LIMIT_REQUESTS_PER_MINUTE=5
RATE_LIMIT_REQUESTS_PER_DAY=20

# Set to skip the run on startup and only run on the cron schedule
# SKIP_INITIAL_RUN=true
